# Exercise media downloaded by installs before v1.4.0 (now in catalogue/media); kept ignored so an
# old folder never gets committed by accident
media/img/
media/gif/

# Runtime data — users, passkeys, per-user state, session secret
data/

# Local config
.env

# Build output / deps
frontend/dist/
node_modules/
*.log
.DS_Store
node_modules
.claude/
.agents/
.superpowers/

# Nix build result symlinks
result
result-*

# CI reports (test:* jobs write these next to the suites)
junit.xml
coverage/
frontend/bundle-size.json

# Local planning notes
docs/superpowers/plans/

# Android signing material — never commit these. A keystore in the history is a leaked private
# key: it cannot be removed without rewriting the branch, and anything signed with it is
# compromised. scripts/make-android-keystore.sh writes these into $HOME by default.
*.jks
*.keystore
*.p12
*.pepk
keystore.properties
# The base64 form of a keystore is the keystore. scripts/make-android-keystore.sh writes
# $OUT.b64 next to it; both spellings are covered so an older one cannot slip in.
*.b64
*.jks.base64.txt
*.keystore.base64.txt
